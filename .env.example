# Copy to .env (git-ignored) and fill in locally. Never commit real values.

# PostgreSQL connection for the recorder.
DATABASE_URL=postgresql://polyquant@127.0.0.1:54329/polyquant

# Polymarket US API credentials (Phase 2b, read-only use). Generate at https://polymarket.us/developer.
# Leave empty to run on public gateway data only.
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=

# Public gateway request budget (requests/second). The gateway returned 429s at ~5 req/s in testing.
GATEWAY_MAX_RPS=2

# API server bind address (read-only API). Keep on localhost.
API_HOST=127.0.0.1
API_PORT=8787

# NOTE: there is intentionally no LIVE_TRADING_ENABLED variable. Live trading is disabled in code.

# Seconds between BBO requests (round-robin over open instruments).
BBO_POLL_INTERVAL_S=1.0

# Markets WebSocket (used automatically when the key above is set). Read-only market data only.
WS_ENABLED=true
WS_IDLE_TIMEOUT_S=30
# REST /bbo poll interval while the WebSocket is active (cross-check only; REST is CDN-cached up to 30 s).
BBO_RECONCILE_INTERVAL_S=5
# Stored order-book depth per side (0 = full depth; full depth measured at ~1.4 GB/day for 3 active markets).
BOOK_RECORD_LEVELS=0
# Alert when the local clock lags the venue by more than this (lower-bound estimate from venue timestamps).
CLOCK_SKEW_ALERT_MS=250
